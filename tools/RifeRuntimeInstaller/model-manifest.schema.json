{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marcmy/VideoRenderer/tools/RifeRuntimeInstaller/model-manifest.schema.json",
  "title": "MPC-VR RIFE release model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "model",
    "file",
    "sourceRelease",
    "sourceArchiveSha256",
    "input",
    "output",
    "precision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "model": {
      "const": "RIFE 4.6"
    },
    "file": {
      "const": "rife_v4.6.onnx"
    },
    "sourceRelease": {
      "const": "model-20220923"
    },
    "sourceArchiveSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input": {
      "type": "array",
      "prefixItems": [
        { "const": 1 },
        { "const": 11 },
        { "const": "H" },
        { "const": "W" }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "output": {
      "type": "array",
      "prefixItems": [
        { "const": 1 },
        { "const": 3 },
        { "const": "H" },
        { "const": "W" }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "precision": {
      "const": "mixed-fp16-fp32"
    }
  }
}
