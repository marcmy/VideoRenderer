<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SvpCoreDir>$(MSBuildThisFileDirectory)</SvpCoreDir>
    <NasmPath Condition="'$(NasmPath)'==''">nasm.exe</NasmPath>
    <SvpAssemblerFormat Condition="'$(Platform)'=='x64'">win64</SvpAssemblerFormat>
    <SvpAssemblerFormat Condition="'$(Platform)'=='Win32'">win32</SvpAssemblerFormat>
    <SvpArch64 Condition="'$(Platform)'=='x64'">1</SvpArch64>
    <SvpArch64 Condition="'$(Platform)'=='Win32'">0</SvpArch64>
    <!-- MSVC x86 C symbols have a leading underscore; x64 symbols do not. -->
    <SvpSymbolPrefix Condition="'$(Platform)'=='Win32'">-DPREFIX</SvpSymbolPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="$(SvpCoreDir)mvframe.cpp;$(SvpCoreDir)mvframe_interpolation.cpp;$(SvpCoreDir)planeofblocks.cpp;$(SvpCoreDir)search.cpp;$(SvpCoreDir)groupofplanes.cpp;$(SvpCoreDir)blockmath.cpp;$(SvpCoreDir)x264_pixel.cpp;$(SvpCoreDir)x264_cpu.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PreprocessorDefinitions>Q_OS_WIN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">Q_PROCESSOR_X86_64;Q_OS_WIN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClInclude Include="$(SvpCoreDir)*.h" />
    <CustomBuild Include="$(SvpCoreDir)x86\const-a.asm;$(SvpCoreDir)x86\cpu-a.asm;$(SvpCoreDir)x86\pixel-a.asm;$(SvpCoreDir)x86\sad-a.asm">
      <Command>if not exist "$(IntDir)SVPflow1" mkdir "$(IntDir)SVPflow1"
"$(NasmPath)" -f $(SvpAssemblerFormat) -w-macro-params-legacy $(SvpSymbolPrefix) -DARCH_X86_64=$(SvpArch64) -DHIGH_BIT_DEPTH=0 -DBIT_DEPTH=8 -I"$(SvpCoreDir)/" -o "$(IntDir)SVPflow1\%(Filename).obj" "%(FullPath)"</Command>
      <Outputs>$(IntDir)SVPflow1\%(Filename).obj</Outputs>
      <AdditionalInputs>$(SvpCoreDir)x86\x86inc.asm;$(SvpCoreDir)x86\x86util.asm;%(AdditionalInputs)</AdditionalInputs>
      <Message>Assembling SVPflow1 %(Filename) ($(Platform))</Message>
      <LinkObjects>true</LinkObjects>
    </CustomBuild>
    <CustomBuild Include="$(SvpCoreDir)x86\bilinear.asm;$(SvpCoreDir)x86\pixel-32.asm" Condition="'$(Platform)'=='Win32'">
      <Command>if not exist "$(IntDir)SVPflow1" mkdir "$(IntDir)SVPflow1"
"$(NasmPath)" -f win32 -w-macro-params-legacy $(SvpSymbolPrefix) -DARCH_X86_64=0 -DHIGH_BIT_DEPTH=0 -DBIT_DEPTH=8 -I"$(SvpCoreDir)/" -o "$(IntDir)SVPflow1\%(Filename).obj" "%(FullPath)"</Command>
      <Outputs>$(IntDir)SVPflow1\%(Filename).obj</Outputs>
      <AdditionalInputs>$(SvpCoreDir)x86\x86inc.asm;$(SvpCoreDir)x86\x86util.asm;%(AdditionalInputs)</AdditionalInputs>
      <LinkObjects>true</LinkObjects>
    </CustomBuild>
  </ItemGroup>
</Project>
